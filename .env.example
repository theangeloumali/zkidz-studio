# Created by The Angelo Umali.
# Non-secret settings only. Your Claude API key goes in through the app and is stored in the OS keychain, never here.

# Data folder. Empty uses the OS default (for example ~/.local/share/zkidz-studio).
ZKS_HOME=
# Local server port. The server binds 127.0.0.1 only.
ZKS_PORT=4317
# Path to an ffmpeg you already have. Empty uses the one setup downloads.
ZKS_FFMPEG=

# Optional Postgres (Supabase Docker option). Leave empty for the built-in database.
# Loopback hosts only, for example postgres://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
