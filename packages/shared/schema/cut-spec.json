{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sourceAssetId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "durationS": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fps": {
      "type": "object",
      "properties": {
        "num": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "den": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "num",
        "den"
      ],
      "additionalProperties": false
    },
    "removals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "pin": {
            "type": "boolean"
          },
          "fromCandidate": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "at",
          "end",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "trimPauses": {
      "type": "object",
      "properties": {
        "thresholdDb": {
          "type": "number",
          "maximum": 0
        },
        "minS": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "keepS": {
          "type": "number",
          "minimum": 0
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "at",
              "end"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "thresholdDb",
        "minS",
        "keepS",
        "exclude"
      ],
      "additionalProperties": false
    },
    "faceCamRanges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "at",
          "end"
        ],
        "additionalProperties": false
      }
    },
    "cutaways": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "sub": {
            "type": "string"
          },
          "style": {
            "type": "string",
            "enum": [
              "wipe",
              "card"
            ]
          }
        },
        "required": [
          "at",
          "end",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "bleeps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1080
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1920
          }
        },
        "required": [
          "at",
          "end",
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "blurBoxes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1080
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1920
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1080
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1920
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "at",
          "end",
          "x",
          "y",
          "w",
          "h",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "zooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "preset": {
            "type": "string",
            "enum": [
              "snap",
              "push",
              "reveal",
              "through-out",
              "through-in",
              "portal"
            ]
          },
          "cx": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "cy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "at",
          "end",
          "preset"
        ],
        "additionalProperties": false
      }
    },
    "portals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "corners": {
            "type": "array",
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1080
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1920
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1080
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1920
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1080
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1920
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1080
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1920
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "at",
          "end",
          "corners"
        ],
        "additionalProperties": false
      }
    },
    "matteRanges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "at",
          "end"
        ],
        "additionalProperties": false
      }
    },
    "baseVideoId": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "isReel": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "sourceAssetId",
    "durationS",
    "fps",
    "removals"
  ],
  "additionalProperties": false
}
