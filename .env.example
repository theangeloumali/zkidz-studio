# Created by The Angelo Umali.
# Non-secret settings only. Your Claude API key goes in through the app and is stored in the OS keychain, never here.

# Data folder. Empty uses the OS default (for example ~/.local/share/zkidz-studio).
ZKS_HOME=
# Local server port. The server binds 127.0.0.1 only.
ZKS_PORT=4317
# Path to an ffmpeg you already have. Empty uses the one setup downloads.
ZKS_FFMPEG=

# Optional Postgres (Supabase Docker option). Leave empty for the built-in database.
# Loopback hosts only: postgresql://postgres:<generated>@127.0.0.1:45322/postgres
# db:supabase:start generates the password per install; print the URL with `pnpm --silent db:supabase:url`.
DATABASE_URL=

# Docker terminal mode: the Claude Code release to install in the image (empty installs nothing).
CLAUDE_CODE_VERSION=
# Docker remote mode (docker/compose.remote.yml): the https origins your TLS proxy publishes. Set both or neither.
ZKS_PUBLIC_ORIGIN=
ZKS_PREVIEW_PUBLIC_ORIGIN=
# Remote mode: a random secret of 32+ characters. The proxy sends it as x-zks-proxy-secret; never reuse a password.
ZKS_PROXY_SECRET=
